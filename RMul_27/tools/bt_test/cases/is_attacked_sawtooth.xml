<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4" main_tree_to_execute="T">
  <BehaviorTree ID="T">
    <Fallback>
      <Sequence>
        <SubRobotStatus topic_name="/robot_status" robot_status="{robot_status}"/>
        <IsAttacked message="{robot_status}" hp_threshold="10" timeout_msec="10000"/>
        <PrintMessage message_to_print="CASE_RESULT:PASS"/>
      </Sequence>
      <PrintMessage message_to_print="CASE_RESULT:FAIL"/>
    </Fallback>
  </BehaviorTree>
</root>
