<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4" main_tree_to_execute="T">
  <BehaviorTree ID="T">
    <Fallback>
      <Sequence>
        <SubAllRobotHP topic_name="/robot_hp" robot_hp="{robot_hp}"/>
        <IsOutpostOK robot_hp="{robot_hp}" hp_threshold="100"/>
        <PrintMessage message_to_print="CASE_RESULT:PASS"/>
      </Sequence>
      <PrintMessage message_to_print="CASE_RESULT:FAIL"/>
    </Fallback>
  </BehaviorTree>
</root>
